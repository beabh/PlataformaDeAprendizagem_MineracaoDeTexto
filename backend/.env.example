# Copie para .env e ajuste. Em produção, troque todos os valores "troque-".
PLN_AMBIENTE=desenvolvimento          # ou "producao" (desliga o login de teste e exige as chaves)
PLN_DATABASE_URL=postgresql+psycopg://pln:pln@localhost:5432/plataforma_pln
PLN_SEGREDO_SESSAO=troque-este-segredo-em-producao
PLN_CHAVE_CPF=                         # chave Fernet (base64). Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLN_URL_PUBLICA=http://localhost:8000
PLN_TURMA_PADRAO=TURMA-PADRAO
# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: PLN_URL_PUBLICA + /auth/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
