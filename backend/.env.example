# Copie para .env e ajuste. Em produção, troque todos os valores "troque-".
PLN_AMBIENTE=desenvolvimento          # ou "producao" (exige as chaves e desliga a entrada de teste)
# Banco: SQLite (um arquivo, sem instalar nada) ou PostgreSQL (postgresql+psycopg://usuario:senha@host:5432/banco)
PLN_DATABASE_URL=sqlite:///./plataforma.db
PLN_SEGREDO_SESSAO=troque-este-segredo-em-producao
# Chave Fernet (base64) dos dados pessoais. Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Não troque a chave depois de cadastrar pessoas: os dados cifrados deixam de ser lidos.
PLN_CHAVE_CRIPTO=
PLN_TURMA_PADRAO=TURMA-PADRAO
